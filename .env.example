# Copy to .env.local and fill in. .env.local is gitignored.
#
# All env vars used by this project, in one place. If something below
# is empty in dev, the code falls back to deterministic stub data so
# pages still render — no envs are strictly required to boot the app.

# ── Supabase auth (staff login on /admin) ─────────────────────────────
# Required for production. In dev with these absent, the proxy + AdminShell
# skip the auth check so designers can iterate without secrets. Set up:
#   1. Create a Supabase project (https://supabase.com/dashboard)
#   2. Auth → Providers → enable Google, paste your OAuth client ID/secret
#   3. Auth → URL Configuration → add http://localhost:3002/auth/callback
#      and https://yourdomain.com/auth/callback to the redirect allowlist
#   4. Copy the project URL and the **publishable** anon key below
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── SerpApi (Google Shopping comparable-price search) ─────────────────
# Used by /api/comparables and the Add Item flow. Falls back to a
# bundled fixture in dev when missing. Get a key at https://serpapi.com.
SERPAPI_KEY=

# ── Catalog photo cleanup (glass-aware) ───────────────────────────────
# Default /api/clean-background mode is Gemini "studio" (GEMINI_API_KEY).
# Cutout APIs punch through door/window glass — use only for opaque items
# via mode:"cutout", and only with a PRODUCTION Photoroom key (not sandbox).
# PHOTOROOM_API_KEY=
# REMOVE_BG_API_KEY=

# ── (Future) Stripe ───────────────────────────────────────────────────
# Not yet wired. When the storefront takes real money, add:
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# ── (Future) AI staging ───────────────────────────────────────────────
# Not yet wired. When the catalog runs AI hero photos, add:
# GEMINI_API_KEY=     # or whichever model the safety-net report picks

# ── Resend (inquiry form email delivery) ──────────────────────────────
# REQUIRED in production. The InquiryForm on /four-squared,
# /builders-corner, /builders-corner/consultation submits leads via the
# Resend HTTP API to INQUIRY_TO_EMAIL. Without RESEND_API_KEY the form
# still works in dev (writes to data/inquiries.json) but will silently
# log + show a friendly error in production.
#
# Setup (10 min):
#   1. https://resend.com → sign up (free tier covers our volume)
#   2. Add and verify your sending domain, OR use the included
#      onboarding@resend.dev sender for testing
#   3. Paste the API key + the destination address below
RESEND_API_KEY=
INQUIRY_TO_EMAIL=pricelessbuildingcenter@gmail.com
# INQUIRY_FROM_EMAIL=Price-Less Building <inquiries@yourdomain.com>

# ── Production gates ──────────────────────────────────────────────────
# Set PUBLIC_ADMIN_ENABLED=1 ONLY when Supabase auth is also wired and
# the /admin section is ready for the public internet. Without this var,
# /admin/* returns 404 in production (NODE_ENV=production) even if the
# Supabase vars are present, so we don't accidentally leak admin during
# pre-launch deploys.
# PUBLIC_ADMIN_ENABLED=1

# Local-only admin bypass. Set to 1 in .env.local to open /admin WITHOUT a
# Google sign-in while developing (handy for testing inventory/cost/aging/
# sold screens). HARD-GATED to non-production in code (NODE_ENV !==
# 'production'), so it can never unlock a live deploy — but never set it in
# the hosting env anyway. Off by default.
# DEV_ADMIN_BYPASS=1

# ── Inventory intake + Brother QL-800 (local Mac) ─────────────────────
# Staff inventory UI lives at /admin/inventory (Google OAuth + allowlist).
# Label printing uses CUPS `lp` on the machine with the USB QL-800 — it
# cannot run on Vercel. Set these in .env.local on the store Mac:
# PRINTER_QUEUE=Brother_QL_800
# LABEL_ROLL=62
# APP_BASE_URL=http://192.168.1.105:3002
# ALLOWED_EMAILS=you@gmail.com
# GEMINI_API_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ── Bot protection (Cloudflare Turnstile) ─────────────────────────────
# Optional but recommended for the customer sign-up / sign-in / password
# reset forms. When this site key is set, those forms render a Turnstile
# challenge and pass the token to Supabase. You must ALSO enable CAPTCHA
# in Supabase (Auth → Settings → Bot & Abuse Protection → Turnstile) and
# paste the matching SECRET key there — Supabase verifies the token
# server-side, so the secret never ships to the browser. Without this key
# the forms work normally (no challenge), so it's safe to leave unset in
# local dev. Get a key pair at https://dash.cloudflare.com → Turnstile.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Storefront catalog gate ───────────────────────────────────────────
# When unset, /shop and home advertise real department depth (walkthrough
# + floor photos) instead of the demo/sandbox SKU grids. Flip on once
# real tagged inventory is ready to publish:
# NEXT_PUBLIC_CATALOG_LIVE=1
#
# Local design only — allow the 40-item seed catalog when Supabase isn't
# configured:
# ALLOW_SEED_CATALOG=1

# ── Next.js image optimization ────────────────────────────────────────
# OFF by default — exhausted Vercel Image Optimization quota returns 402
# and blanks category/hero photos. Leave unset (or anything other than
# "on") to serve originals. Re-enable only when quota is healthy:
# IMAGE_OPTIMIZATION=on

# ── (Future) Stripe ───────────────────────────────────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# ── (Future) Google Places (live reviews on TrustBlock) ───────────────
# GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACES_ID=
